    "devDependencies": {
        "@types/jest": "^29.5.14",
        "eslint": "^9.12.0",
        "@typescript-eslint": "^8.71.2",
        "eslint-plugin-jest": "^29.16.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.0.0",
        "npm-pack-zip": "^1.3.0",
        "prettier": "^3.3.3",
